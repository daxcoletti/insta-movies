# Copiá este archivo a `.env` (que está gitignored) y completá los valores.
#   cp .env.example .env && chmod 600 .env
# NINGUNA key real debe entrar a este archivo de ejemplo.

# --- Claude API (extracción de títulos / canciones) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Instagram ---
IG_LOGIN_USER=tu_usuario_de_ig     # cuenta esperada al importar cookies del navegador
PROFILE=juan.amonda                # perfil de películas
MUSIC_PROFILE=owencutts            # perfil de música

# --- Google Drive (rclone) ---
DRIVE_DEST=drive:insta-movies

# --- Transcripción de audio (capa 3 del pipeline de música) ---
# Groq acepta varias keys separadas por coma, y además _2, _3, ... para rotar ante 429.
GROQ_API_KEY=
GROQ_API_KEY_2=
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
# Fallback sin cuota: whisper CLI por SSH. Vaciar WHISPER_SSH_HOST para desactivarlo.
WHISPER_SSH_HOST=
WHISPER_SSH_MODEL=large-v3-turbo

# --- Spotify (pipeline de música) ---
# App creada en https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PLAYLIST_NAME=Old Music Friday
